---
interface Props { title?: string; kicker?: string; tone?: 'green' | 'purple' | 'pink' | 'plain' }
const { title, kicker, tone = 'green' } = Astro.props;
---
<div class:list={['card', tone !== 'green' && tone]}>
  {kicker && <span class="card-kicker">{kicker}</span>}
  {title && <span class="card-title">{title}</span>}
  <slot />
</div>
