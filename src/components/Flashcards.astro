---
interface Props {
  topic: string;
  cards: { front: string; back: string }[];
}
const { topic, cards } = Astro.props;
---
<div class="deck" data-topic={topic} data-cards={JSON.stringify(cards)}>
  <noscript>The flashcards need JavaScript.</noscript>
</div>

<script>
  type Card = { front: string; back: string };

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  document.querySelectorAll<HTMLElement>('.deck').forEach((root) => {
    const cards: Card[] = JSON.parse(root.dataset.cards || '[]');
    const key = `fc:${root.dataset.topic}`;

    // Progress lives in sessionStorage only: survives a refresh, cleared when the tab closes.
    function loadKnown(): number[] {
      try {
        const s = JSON.parse(sessionStorage.getItem(key) || 'null');
        if (s && Array.isArray(s.known)) return s.known.filter((n: unknown) => typeof n === 'number' && n < cards.length);
      } catch {}
      return [];
    }
    function persist() {
      try {
        sessionStorage.setItem(key, JSON.stringify({ known: [...known] }));
      } catch {}
    }

    let known = new Set<number>(loadKnown());
    let order = cards.map((_, i) => i);
    let pos = 0;
    let onlyLearning = false;
    let flipped = false;

    const visible = () => (onlyLearning ? order.filter((i) => !known.has(i)) : order);

    function render() {
      const list = visible();
      if (pos >= list.length) pos = Math.max(0, list.length - 1);
      const status = `
        <div class="quiz-status">
          <span>Known: <b>${known.size}/${cards.length}</b></span>
          <label class="chk"><input type="checkbox" data-only ${onlyLearning ? 'checked' : ''}> Only "Still learning"</label>
          <button type="button" class="linkbtn" data-shuffle>Shuffle</button>
          <button type="button" class="linkbtn push" data-reset>Reset progress</button>
        </div>`;
      if (!list.length) {
        root.innerHTML = `${status}
          <div class="deck-empty">
            <p class="score">All known</p>
            <p>Every card is marked as known. Untick the filter to see all cards, or reset progress.</p>
          </div>`;
        bind();
        return;
      }
      const i = list[pos];
      const c = cards[i];
      root.innerHTML = `${status}
        <div class="qmeta"><span>Card ${pos + 1} of ${list.length}</span><span>${known.has(i) ? 'Known' : 'Still learning'}</span></div>
        <button type="button" class="flip${flipped ? ' flipped' : ''}" data-flip aria-label="Flip card">
          <span class="inner">
            <span class="face front">${esc(c.front)}</span>
            <span class="face back">${esc(c.back)}</span>
          </span>
        </button>
        <p class="cap center">Tap the card or press Space to flip · ← → to move</p>
        <div class="btnrow">
          <button type="button" class="btn alt" data-prev>← Prev</button>
          <button type="button" class="btn learning" data-learning>Still learning</button>
          <button type="button" class="btn known" data-known>Know it</button>
          <button type="button" class="btn alt" data-next>Next →</button>
        </div>`;
      bind();
    }

    function go(delta: number) {
      const n = visible().length;
      if (!n) return;
      pos = (pos + delta + n) % n;
      flipped = false;
      render();
    }

    function mark(isKnown: boolean) {
      const list = visible();
      if (!list.length) return;
      const i = list[pos];
      if (isKnown) known.add(i);
      else known.delete(i);
      persist();
      flipped = false;
      // In "only still learning" mode a known card drops out, so the next card slides into place.
      if (!(onlyLearning && isKnown)) pos = (pos + 1) % Math.max(1, visible().length);
      render();
    }

    function bind() {
      root.querySelector<HTMLInputElement>('[data-only]')?.addEventListener('change', (e) => {
        onlyLearning = (e.target as HTMLInputElement).checked;
        pos = 0;
        flipped = false;
        render();
      });
      root.querySelector('[data-shuffle]')?.addEventListener('click', () => {
        for (let i = order.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [order[i], order[j]] = [order[j], order[i]];
        }
        pos = 0;
        flipped = false;
        render();
      });
      root.querySelector('[data-reset]')?.addEventListener('click', () => {
        known = new Set();
        persist();
        order = cards.map((_, i) => i);
        pos = 0;
        flipped = false;
        render();
      });
      root.querySelector('[data-flip]')?.addEventListener('click', (e) => {
        flipped = !flipped;
        (e.currentTarget as HTMLElement).classList.toggle('flipped', flipped);
      });
      root.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
      root.querySelector('[data-next]')?.addEventListener('click', () => go(1));
      root.querySelector('[data-known]')?.addEventListener('click', () => mark(true));
      root.querySelector('[data-learning]')?.addEventListener('click', () => mark(false));
    }

    document.addEventListener('keydown', (e) => {
      const el = document.activeElement;
      const typing = el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA');
      if (typing) return;
      if (e.key === 'ArrowRight') go(1);
      else if (e.key === 'ArrowLeft') go(-1);
      // Space on a focused button already triggers its click; only handle it when nothing is focused.
      else if (e.key === ' ' && (!el || el === document.body)) {
        e.preventDefault();
        const card = root.querySelector<HTMLElement>('[data-flip]');
        if (!card) return;
        flipped = !flipped;
        card.classList.toggle('flipped', flipped);
      }
    });

    render();
  });
</script>
