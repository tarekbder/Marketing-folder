---
import Base from '../layouts/Base.astro';
import { sortedTopics, pad } from '../lib/topics';
const topics = await sortedTopics();
---
<Base title="Home">
  <header class="hero" slot="hero">
    <div class="wrap">
      <span class="tag">M_06</span><span class="tag pink">CODE University of Applied Sciences</span>
      <h1>Digital Marketing &amp; Business Models</h1>
      <p class="lead">A study companion for the Digital Marketing block: every lecture explained, the mid-term poster decoded, and exercises to test yourself.</p>
    </div>
  </header>

  <div class="tlist home-sections" style="margin-top:32px">
    <a class="tcard" href="/topics/">
      <span class="n">Section 01</span>
      <h3>Topic explainers</h3>
      <p>Six lectures, each with its frameworks, examples, exercises and key terms.</p>
    </a>
    <a class="tcard pink" href="/assessment/">
      <span class="n">Section 02</span>
      <h3>Assessment explainer</h3>
      <p>The interactive poster, it tells you what you need to do, where to find it and the rules.</p>
    </a>
    <a class="tcard green" href="/exercises/">
      <span class="n">Section 03</span>
      <h3>Exercises</h3>
      <p>Multiple-choice quizzes and flashcard decks for every lecture.</p>
    </a>
  </div>

  <h2 style="margin-top:44px">The course</h2>
  <div class="prose">
    <table>
      <thead><tr><th>#</th><th>Lecture</th><th>Unit</th></tr></thead>
      <tbody>
        {topics.map((t) => (
          <tr>
            <td class="mono">{pad(t.data.order)}</td>
            <td><a href={`/topics/${t.id}/`}>{t.data.title}</a></td>
            <td>{t.data.unitName}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="callout warn" style="margin-top:32px">
    <p class="callout-title">Please note</p>
    <p><b>For educational purposes only.</b> This is an unofficial study aid, not a CODE University resource. Content is summarised from the lecture slides and from lecture notes by Zach, and may contain mistakes: when in doubt, the original lecture materials win.</p>
    <p>Quiz and flashcard progress is saved only for this browser tab: it survives a page refresh and is cleared when you close the tab. No accounts.</p>
  </div>
</Base>
