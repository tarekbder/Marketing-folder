---
interface Props { data: string[]; insight: string }
const { data, insight } = Astro.props;
---
<div class="di">
  <div class="d"><span class="lbl">Data</span>{data.map((d) => <p>{d}</p>)}</div>
  <div class="arrow" aria-hidden="true">→</div>
  <div class="i"><div><span class="lbl">Insight</span>{insight}</div></div>
</div>
