---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Study site for M_06 Digital Marketing & Business Models: topic explainers, assessment guide, MCQs and flashcards.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/topics/', label: 'Topics' },
  { href: '/assessment/', label: 'Assessment' },
  { href: '/exercises/', label: 'Exercises' },
];
const isActive = (href: string) => path.startsWith(href.replace(/\/$/, ''));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · M_06 Study</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-in">
        <a class="brand" href="/">M_06 · Digital Marketing</a>
        <nav class="mainnav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light or dark mode" title="Toggle light/dark">◐</button>
      </div>
    </header>
    <slot name="hero" />
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">For educational purposes only · M_06 Digital Marketing &amp; Business Models · Progress is kept for this browser tab only</div>
    </footer>
    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
